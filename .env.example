MP_ENV=development
MP_DATABASE_URL=sqlite:///./var/metric-pulse.db
MP_OBJECT_ROOT=./var/objects
MP_EXPORT_ROOT=./var/exports
MP_SOURCE_CACHE_ROOT=./var/source-cache
MP_STORAGE_BACKEND=filesystem
MP_S3_ENDPOINT_URL=
MP_S3_BUCKET=metric-pulse
MP_S3_ACCESS_KEY=
MP_S3_SECRET_KEY=
MP_S3_REGION=auto
MP_CORS_ORIGINS=http://localhost:5173
MP_SESSION_COOKIE_SECURE=false
MP_BOOTSTRAP_USERNAME=admin
MP_BOOTSTRAP_PASSWORD=change-me
MP_CELERY_BROKER_URL=redis://localhost:6379/0
MP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
MP_EAGER_TASKS=true
MP_OMLX_BASE_URL=http://10.0.0.203:5008/v1
MP_OMLX_MODEL=Qwen3.8-27B-6bit
MP_OMLX_API_KEY=
MP_OMLX_TIMEOUT_SECONDS=900
MP_OMLX_MAX_OUTPUT_TOKENS=4096
MP_OMLX_JSON_RETRY_ATTEMPTS=1
MP_SHEET_ANALYSIS_MAX_OUTPUT_TOKENS=2048
MP_SYNTHESIZE_MAX_OUTPUT_TOKENS=4096
MP_VERIFY_MAX_OUTPUT_TOKENS=4096
MP_VISION_ANALYSIS_ENABLED=true
MP_VISION_TABLE_ENRICHMENT_ENABLED=true
MP_VISION_TABLE_MAX_OUTPUT_TOKENS=8192
MP_VISION_TABLE_RETRY_MAX_OUTPUT_TOKENS=16384
MP_SEARCH_URL=
MP_GITHUB_API_TOKEN=
MP_SEARCH_TIMEOUT_SECONDS=60
MP_SEARCH_MIN_INTERVAL_SECONDS=60
MP_SEARCH_RETRY_DELAY_SECONDS=60
MP_SOURCE_FETCH_CONCURRENCY=3
MP_SOURCE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
MP_SOURCE_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en-US;q=0.7,en;q=0.6
MP_SOURCE_CACHE_TTL_SECONDS=86400
MP_SOURCE_TRANSIENT_COOLDOWN_BASE_SECONDS=60
MP_SOURCE_CHALLENGE_COOLDOWN_SECONDS=3600
MP_SOURCE_COOLDOWN_MAX_SECONDS=3600
MP_SOURCE_HOST_MIN_INTERVAL_SECONDS=2
MP_BROWSER_FALLBACK_ENABLED=true
MP_BROWSER_TIMEOUT_SECONDS=180
MP_BROWSER_SETTLE_SECONDS=5
MP_BROWSER_MIN_CONTENT_CHARS=500
MP_BROWSER_SITE_COOLDOWN_SECONDS=30
MP_ATTACHMENT_DISCOVERY_ENABLED=true
MP_ATTACHMENT_MAX_PER_PARENT=5
MP_ATTACHMENT_MAX_PER_UNIT=8
MP_ATTACHMENT_MAX_TOTAL_BYTES=50000000
